# ============================================================
# BusPass Pro — Frontend (Vite) Environment Variables
# ============================================================
# Copy to apps/web/.env.local for local dev
# Set these in Vercel Dashboard for production builds
# All variables MUST be prefixed with VITE_ to be available in browser
# ============================================================

# API base URL — In development, Vite proxy handles /api → localhost:5000
# In production, set this to your backend URL
VITE_API_URL=https://YOUR_BACKEND_DOMAIN/api

# WebSocket server URL
VITE_SOCKET_URL=https://YOUR_BACKEND_DOMAIN

# Google Client ID (same as backend GOOGLE_CLIENT_ID)
# Only needed if using Google One Tap or GIS library in frontend
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# App name displayed in browser tab / PWA
VITE_APP_NAME=BusPass Pro
