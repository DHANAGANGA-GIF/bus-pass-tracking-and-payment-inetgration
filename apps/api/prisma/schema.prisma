generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  emailVerified     Boolean      @default(false)
  phoneNumber       String       @unique
  phoneVerified     Boolean      @default(false)
  passwordHash      String
  fullName          String
  role              String       @default("USER")
  profilePhotoUrl   String?
  address           String?
  district          String?
  state             String?
  pincode           String?
  emergencyContact  String?
  govtIdType        String?
  govtIdNumber      String?
  studentIdNumber   String?
  employeeIdNumber  String?
  isSuspended       Boolean      @default(false)
  failedLoginCount  Int          @default(0)
  lockedUntil       DateTime?
  
  bookings          Booking[]
  busPasses         BusPass[]
  payments          Payment[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  emailLogs         EmailLog[]
  smsLogs           SmsLog[]
  otps              OtpRecord[]
  refreshTokens     RefreshToken[]
  sessions          Session[]
  invoices          Invoice[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([email])
  @@index([phoneNumber])
}

model Route {
  id              String      @id @default(uuid())
  routeCode       String      @unique
  source          String
  destination     String
  viaStops        String
  distanceKm      Float
  baseMonthlyFare Float
  isActive        Boolean     @default(true)
  
  bookings        Booking[]
  busPasses       BusPass[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([source, destination])
}

model Booking {
  id              String        @id @default(uuid())
  userId          String
  routeId         String
  duration        String
  passengerType   String        @default("GENERAL")
  fareAmount      Float
  status          String        @default("PENDING")
  startDate       DateTime
  expiryDate      DateTime

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  route           Route         @relation(fields: [routeId], references: [id])
  busPass         BusPass?
  payment         Payment?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([routeId])
}

model BusPass {
  id               String        @id @default(uuid())
  passNumber       String        @unique
  userId           String
  routeId          String
  bookingId        String        @unique
  duration         String
  startDate        DateTime
  expiryDate       DateTime
  status           String        @default("PENDING")
  fareAmount       Float
  qrCodeData       String
  barcodeData      String
  verificationHash String
  passengerName    String
  passengerPhoto   String?
  rejectionReason  String?

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  route            Route         @relation(fields: [routeId], references: [id])
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([passNumber])
  @@index([userId])
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  userId          String
  transactionId   String        @unique
  gatewayOrder    String
  amount          Float
  currency        String        @default("INR")
  gateway         String
  status          String        @default("PENDING")
  paidAt          DateTime?
  receiptUrl      String?

  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice         Invoice?
  receipt         Receipt?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([transactionId])
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  paymentId     String    @unique
  userId        String
  amount        Float
  taxAmount     Float
  totalAmount   Float
  pdfUrl        String?

  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
}

model Receipt {
  id            String    @id @default(uuid())
  receiptNumber String    @unique
  paymentId     String    @unique
  pdfUrl        String?

  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpRecord {
  id          String   @id @default(uuid())
  userId      String?
  identifier  String
  otpHash     String
  type        String
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  attempts    Int      @default(0)

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([identifier])
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  familyId    String
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String
  userAgent String
  deviceInfo String?
  lastActive DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  ipAddress String?
  userAgent String?
  details   String?

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(uuid())
  userId    String?
  recipient String
  subject   String
  status    String
  error     String?

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model SmsLog {
  id        String   @id @default(uuid())
  userId    String?
  recipient String
  message   String
  status    String
  error     String?

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Stop {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  location  String?
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id            String   @id @default(uuid())
  fullName      String
  licenseNumber String   @unique
  phoneNumber   String   @unique
  address       String?
  status        String   @default("ACTIVE")
  buses         Bus[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Bus {
  id           String   @id @default(uuid())
  busNumber    String   @unique
  registration String   @unique
  capacity     Int      @default(40)
  busType      String   @default("EXPRESS")
  driverId     String?
  driver       Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  routeId      String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}
