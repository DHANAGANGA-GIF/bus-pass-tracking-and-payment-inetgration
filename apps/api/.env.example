NODE_ENV=development
PORT=5000
HOST=0.0.0.0
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buspass?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="default_dev_jwt_access_secret_min_32_chars_long_key"
JWT_REFRESH_SECRET="default_dev_jwt_refresh_secret_min_32_chars_long_key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PASS_HMAC_SECRET="default_dev_pass_hmac_secret_key_32_chars"
SESSION_SECRET="default_dev_session_secret_key_32_chars"
COOKIE_SECRET="default_dev_cookie_secret_key_32_chars"

FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"
CORS_ORIGIN="http://localhost:3000,http://localhost:5000"

# Optional integrations
OPENAI_API_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"
SENTRY_DSN=""
