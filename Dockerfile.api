FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/

RUN npm ci --include=dev

COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

RUN npm run build --workspace=@bus-pass/shared

WORKDIR /app/apps/api
RUN npx prisma generate
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules

# start.sh: run migration if DATABASE_URL is set, then start server
RUN printf '#!/bin/sh\nset -e\ncd /app/apps/api\nif [ -n "$DATABASE_URL" ]; then\n  echo "Running Prisma migrations..."\n  npx prisma migrate deploy || echo "Warning: migration failed, continuing..."\nfi\nexec node dist/index.js\n' > /start.sh && chmod +x /start.sh

EXPOSE 10000

CMD ["/start.sh"]
